PORT=3000
BASE_URL=https://SEU-DOMINIO.ngrok-free.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DB_PATH=./data/ura.sqlite
DRY_RUN=true
APP_TZ=America/Sao_Paulo
# Voz da ligação (Amazon Polly pela Twilio). Outras em pt-BR: Polly.Vitoria-Neural, Polly.Thiago-Neural, Polly.Vitoria
VOZ=Polly.Camila-Neural
MAX_TENTATIVAS=3
RETRY_MINUTOS=5
# Mantenha true. Use false apenas para depurar localmente (qualquer um poderia forjar chamadas ao webhook).
TWILIO_VALIDAR_ASSINATURA=true
# Chave que assina o login do painel. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se ficar vazia, o servidor gera uma aleatória e guarda em data/.jwt_secret.
JWT_SECRET=
# Login do painel só pela conta do Google. ID do cliente OAuth criado no Google Cloud Console
# (Credenciais > ID do cliente OAuth > Aplicativo da Web). Não é segredo.
GOOGLE_CLIENT_ID=
# O paciente responde falando (qualquer frase que não seja um "sim" claro conta como "não").
# Confiança mínima (0 a 1) para aceitar um "sim" falado; abaixo disso conta como "não" e o sistema liga de novo.
VOZ_CONFIANCA_MINIMA=0.5
