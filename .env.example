# Configuração do LembreMed. O jeito fácil de preencher é rodar: npm run configurar
# (ele pergunta cada valor, explica onde achar e grava este arquivo como .env).

# ---------- Twilio (ligações e SMS) ----------
# console.twilio.com > página inicial > "Account Info"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# console.twilio.com > Phone Numbers > Manage > Active numbers (formato +1...)
TWILIO_PHONE_NUMBER=

# ---------- Endereço público (ngrok) ----------
# Domínio fixo grátis do ngrok: dashboard.ngrok.com > Domains
BASE_URL=https://SEU-DOMINIO.ngrok-free.dev

# ---------- Login do painel (Google) ----------
# console.cloud.google.com > Google Auth Platform > Clientes. Não é segredo.
GOOGLE_CLIENT_ID=

# ---------- Funcionamento ----------
# true = só simula (não liga nem manda SMS); false = liga de verdade
DRY_RUN=true
# Ligações por dose antes de avisar o cuidador e minutos entre elas (recusas rápidas da rede não contam)
MAX_TENTATIVAS=3
RETRY_MINUTOS=2
# Voz da ligação (Amazon Polly pela Twilio). Outras em pt-BR: Polly.Vitoria-Neural, Polly.Thiago-Neural
VOZ=Polly.Camila-Neural
# Confiança mínima (0 a 1) para aceitar um "sim" falado; abaixo disso conta como "não" e o sistema liga de novo.
VOZ_CONFIANCA_MINIMA=0.5
APP_TZ=America/Sao_Paulo
PORT=3000
DB_PATH=./data/ura.sqlite

# ---------- Segurança ----------
# Assina o login do painel. O npm run configurar gera uma; vazia = gerada e guardada em data/.jwt_secret.
JWT_SECRET=
# Mantenha true: só aceita webhooks realmente assinados pela Twilio.
TWILIO_VALIDAR_ASSINATURA=true
