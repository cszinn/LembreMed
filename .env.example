PORT=3000
BASE_URL=https://SEU-DOMINIO.ngrok-free.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DB_PATH=./data/ura.sqlite
DRY_RUN=true
APP_TZ=America/Sao_Paulo
VOZ=Polly.Camila-Neural
MAX_TENTATIVAS=3
RETRY_MINUTOS=5
ALERTA_CANAL=sms
